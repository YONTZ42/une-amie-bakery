---
interface Props {
  position?: "top" | "bottom";
  fill?: string;
  line?: boolean;
  variant?: "soft" | "deep";
}

const {
  position = "bottom",
  fill = "#f8f2ea",
  line = false,
  variant = "soft",
} = Astro.props;

const path = variant === "deep"
  ? "M0,56 C210,128 408,4 650,64 C900,126 1118,30 1440,84 L1440,160 L0,160 Z"
  : "M0,72 C240,18 416,118 700,66 C960,18 1180,102 1440,52 L1440,160 L0,160 Z";
---

<div class:list={["section-curve", `is-${position}`, `is-${variant}`]} aria-hidden="true">
  <svg viewBox="0 0 1440 160" preserveAspectRatio="none">
    <path d={path} fill={fill} stroke={line ? "#c86645" : "none"} stroke-width={line ? "2" : "0"} />
  </svg>
</div>

<style>
  .section-curve {
    position: absolute;
    z-index: 4;
    left: 0;
    width: 100%;
    height: clamp(58px, 9vw, 132px);
    overflow: hidden;
    pointer-events: none;
  }

  .section-curve svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .is-top {
    top: -1px;
    transform: rotate(180deg);
  }

  .is-bottom {
    bottom: -1px;
  }
</style>
